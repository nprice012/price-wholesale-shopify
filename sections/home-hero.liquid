<section class="hero-banner">
  {% if section.settings.hero_image != blank %}
    <div class="hero-media">
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'hero-image', widths: '900, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', alt: section.settings.hero_image.alt | default: 'Price Distribution — over 100 years of distribution experience' | escape }}
    </div>
  {% else %}
    <div class="hero-placeholder">
      <div class="hero-placeholder-inner">
        <p>PRICE DISTRIBUTION</p>
        <h1>OVER 100 YEARS OF DISTRIBUTION EXPERIENCE</h1>
        <span>QUALITY BRANDS &nbsp; | &nbsp; RELIABLE SERVICE &nbsp; | &nbsp; SINCE 1921</span>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Homepage hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero banner image",
      "info": "Upload the approved Price Distribution banner shown in the design mockup."
    }
  ],
  "presets": [{"name": "Homepage hero banner"}]
}
{% endschema %}
