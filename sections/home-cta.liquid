<section class="cta">
  <div class="container cta-inner">
    <div class="cta-copy">
      <p class="cta-eyebrow">Wholesale ordering</p>
      <h2>Ready to order?</h2>
      <p>Existing Price Distribution customer? Sign in to access your wholesale catalog, pricing and online ordering.</p>
    </div>
    <div class="cta-actions">
      <a class="btn" href="{{ routes.account_login_url }}">Customer Login</a>
      <a class="btn cta-secondary" href="/pages/become-a-customer">Become a Customer</a>
    </div>
  </div>
</section>

<style>
  .cta { background:#d71920; color:#fff; padding:58px 0; }
  .cta-inner { display:flex; align-items:center; justify-content:space-between; gap:36px; }
  .cta-copy { max-width:760px; }
  .cta-eyebrow { margin:0 0 8px; color:rgba(255,255,255,.85); font-size:12px; font-weight:800; letter-spacing:.22em; text-transform:uppercase; }
  .cta h2 { margin:0 0 7px; font-size:clamp(30px,4vw,44px); line-height:1.05; font-weight:900; }
  .cta-copy > p:last-child { margin:0; color:rgba(255,255,255,.92); font-size:16px; line-height:1.55; }
  .cta-actions { display:flex; gap:10px; flex:0 0 auto; }
  .cta .btn { background:#fff; color:#12386b; border-color:#fff; white-space:nowrap; }
  .cta .btn:hover { background:#f4f4f4; }
  .cta .cta-secondary { background:transparent; color:#fff; border-color:rgba(255,255,255,.8); }
  .cta .cta-secondary:hover { background:rgba(0,0,0,.08); }
  @media (max-width:760px) { .cta-inner { align-items:flex-start; flex-direction:column; } .cta-actions { flex-wrap:wrap; } }
</style>

{% schema %}
{
  "name": "Customer CTA",
  "settings": [],
  "presets": [{"name": "Customer CTA"}]
}
{% endschema %}
