<header class="site-header">
  <div class="container header-main">
    <a class="brand" href="{{ routes.root_url }}" aria-label="Price Wholesale Distribution home">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 420 | image_tag: class: 'brand-logo', alt: 'Price Distribution' }}
      {% else %}
        <span class="brand-logo-fallback">
          <span class="brand-wave"></span>
          <span class="brand-name">PRICE</span>
          <span class="brand-sub">DISTRIBUTION</span>
        </span>
      {% endif %}
    </a>

    <nav class="nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="/collections/all">Products</a>
      <a href="/pages/brands">Brands</a>
      <a href="/pages/about-us">About Us</a>
      <a href="/pages/service-area">Service Area</a>
      <a href="/pages/become-a-customer">Become a Customer</a>
      <a href="/pages/contact">Contact</a>
    </nav>

    <div class="header-actions">
      {% if customer.b2b? %}
        <a class="order-btn" href="{{ routes.cart_url }}">
          Order Here{% if cart.item_count > 0 %}<span class="order-count">{{ cart.item_count }}</span>{% endif %}
        </a>
      {% endif %}
      {% if customer %}
        <a class="login-btn" href="{{ routes.account_url }}">
          <span class="login-icon" aria-hidden="true">&#128100;</span>
          My Account
        </a>
      {% else %}
        <a class="login-btn" href="{{ routes.account_login_url }}">
          <span class="login-icon" aria-hidden="true">&#128100;</span>
          Customer Login
        </a>
      {% endif %}
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Open menu">Menu</button>
    </div>
  </div>

  <nav class="mobile-nav container" data-mobile-nav hidden aria-label="Mobile navigation">
    <a href="{{ routes.root_url }}">Home</a>
    <a href="/collections/all">Products</a>
    <a href="/pages/brands">Brands</a>
    <a href="/pages/about-us">About Us</a>
    <a href="/pages/service-area">Service Area</a>
    <a href="/pages/become-a-customer">Become a Customer</a>
    <a href="/pages/contact">Contact</a>
    {% if customer.b2b? %}<a href="{{ routes.cart_url }}">Order Here{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>{% endif %}
    {% if customer %}
      <a href="{{ routes.account_url }}">My Account</a>
    {% else %}
      <a href="{{ routes.account_login_url }}">Customer Login</a>
    {% endif %}
  </nav>
</header>

<style>
  .order-btn { display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:40px; padding:0 16px; color:#fff; background:#d71920; border:1px solid #d71920; font-size:12px; font-weight:800; text-decoration:none; white-space:nowrap; }
  .order-btn:hover { color:#fff; background:#12386b; border-color:#12386b; }
  .order-count { display:inline-grid; place-items:center; min-width:20px; height:20px; padding:0 5px; border-radius:10px; background:#fff; color:#d71920; font-size:10px; }
  @media (max-width:980px) { .order-btn { display:none; } }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo"}
  ]
}
{% endschema %}
