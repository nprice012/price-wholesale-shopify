<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-logo-slot" aria-label="Price Wholesale Distribution logo"></div>
        <p class="footer-copy">Family owned since 1921. Serving wholesale customers throughout the Baltimore and Washington market with trusted brands and dependable service.</p>
      </div>
      <div>
        <div class="footer-title">Company</div>
        <div class="footer-links">
          <a href="/pages/about-us">About Us</a>
          <a href="/pages/brands">Brands</a>
          <a href="/pages/service-area">Service Area</a>
          <a href="/pages/contact">Contact</a>
        </div>
      </div>
      <div>
        <div class="footer-title">Customers</div>
        <div class="footer-links">
          <a href="{{ routes.account_login_url }}">Customer Login</a>
          <a href="/pages/become-a-customer">Become a Customer</a>
          <a href="{{ routes.collections_url }}">Wholesale Products</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} Price Wholesale Distribution. All rights reserved.</span>
      <span>Serving Baltimore &amp; Washington since 1921.</span>
    </div>
  </div>
</footer>

<style>
.footer-logo-slot{min-height:72px;margin-bottom:18px;display:flex;align-items:center}.footer-logo-slot img,.footer-logo-slot .brand-logo{display:block;width:154px;max-width:100%;height:auto}.footer-logo-slot .brand-logo-fallback{display:inline-flex;flex-direction:column;line-height:.9;color:#fff}.footer-logo-slot .brand-logo-fallback .brand-name{font-size:34px;font-weight:900;font-style:italic;letter-spacing:-.07em}.footer-logo-slot .brand-logo-fallback .brand-sub{font-size:11px;font-weight:800;letter-spacing:.14em;margin-top:5px;color:#d9e7f6}.footer-copy{max-width:470px}
</style>

<script>
(function(){
  function syncFooterLogo(){
    var slot=document.querySelector('.footer-logo-slot');
    var source=document.querySelector('.site-header .brand-logo, .site-header .brand-logo-fallback');
    if(!slot || !source || slot.dataset.synced==='true') return;
    var clone=source.cloneNode(true);
    clone.removeAttribute('id');
    if(clone.tagName==='IMG') clone.alt='Price Wholesale Distribution';
    slot.innerHTML='';
    slot.appendChild(clone);
    slot.dataset.synced='true';
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',syncFooterLogo); else syncFooterLogo();
  window.addEventListener('load',syncFooterLogo);
})();
</script>

{% schema %}
{"name":"Footer","settings":[]}
{% endschema %}
