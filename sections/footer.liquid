<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand" data-footer-brand>
          <span class="footer-brand-fallback">
            <span class="brand-name">PRICE</span>
            <span class="brand-sub">DISTRIBUTION</span>
          </span>
        </div>
        <p class="footer-copy">Family owned since 1921. Serving wholesale customers throughout the Baltimore and Washington market with trusted brands and dependable service.</p>
        <div class="footer-contact">
          <a href="tel:4436045677">443-604-5677</a>
          <a href="mailto:Nprice.icd@gmail.com">Nprice.icd@gmail.com</a>
        </div>
      </div>
      <div>
        <div class="footer-title">Company</div>
        <div class="footer-links">
          <a href="/pages/about-us">About Us</a>
          <a href="/pages/brands">Brands</a>
          <a href="/pages/service-area">Service Area</a>
          <a href="/pages/contact">Contact</a>
        </div>
      </div>
      <div>
        <div class="footer-title">Customers</div>
        <div class="footer-links">
          <a href="{{ routes.account_login_url }}">Customer Login</a>
          <a href="/pages/become-a-customer">Become a Customer</a>
          <a href="{{ routes.collections_url }}">Wholesale Products</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} Price Wholesale Distribution. All rights reserved.</span>
      <span>Serving Baltimore &amp; Washington since 1921.</span>
    </div>
  </div>
</footer>

<script>
  (function () {
    var footer = document.querySelector('[data-footer-brand]');
    var headerBrand = document.querySelector('.brand');
    if (!footer || !headerBrand) return;
    var logo = headerBrand.querySelector('.brand-logo, .brand-logo-fallback');
    if (!logo) return;
    var clone = logo.cloneNode(true);
    clone.classList.remove('brand-logo');
    clone.classList.add('footer-logo');
    footer.innerHTML = '';
    footer.appendChild(clone);
  })();
</script>

<style>
.footer-brand{min-height:54px;margin-bottom:18px}.footer-logo{display:block;width:154px;max-width:100%;height:auto}.footer-brand-fallback{display:inline-flex;flex-direction:column;line-height:.9;color:#fff}.footer-brand-fallback .brand-name{font-size:34px;font-weight:900;font-style:italic;letter-spacing:-.07em}.footer-brand-fallback .brand-sub{font-size:11px;font-weight:800;letter-spacing:.14em;margin-top:5px;color:#d9e7f6}.footer-copy{max-width:470px}.footer-contact{display:flex;flex-direction:column;gap:5px;margin-top:14px}.footer-contact a{color:#fff;text-decoration:none;font-weight:700}.footer-contact a:hover{text-decoration:underline}
</style>

{% schema %}
{
  "name":"Footer",
  "settings":[]
}
{% endschema %}
