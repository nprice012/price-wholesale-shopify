<section class="page-shell catalog-page">
  <div class="container">
    <div class="catalog-heading">
      <p class="eyebrow">Wholesale catalog</p>
      <h1 class="page-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="rte catalog-description">{{ collection.description }}</div>{% endif %}
    </div>

    {% if collection.handle == 'ice-cream' %}
      <div class="catalog-navigation">
        <div class="catalog-nav-heading">
          <p class="eyebrow">Shop Ice Cream</p>
          <h2>Shop by Brand</h2>
          <p>Choose a brand first, then select the package size or format you need.</p>
        </div>
        <div class="brand-sections">
          <div class="brand-section"><h3>Philadelphia Water Ice</h3><div class="brand-size-links"><a href="/search?q=PWI%202.5gal&type=product">2.5 Gallon Tubs</a><a href="/search?q=PWI%208%20oz&type=product">8 oz · 12 ct</a></div></div>
          <div class="brand-section"><h3>Turkey Hill</h3><div class="brand-size-links"><a href="/search?q=Turkey%20Hill%2048oz&type=product">48 oz · 6 pk</a></div></div>
          <div class="brand-section"><h3>J&amp;J</h3><div class="brand-size-links"><a href="/search?q=J%26J%203gal&type=product">3 Gallon</a><a href="/search?q=J%26J%203%20oz&type=product">3 oz · Cups</a><a href="/search?q=J%26J%206oz&type=product">6 oz · 12 ct</a><a href="/search?q=J%26J&type=product">24 ct · Novelties</a><a href="/search?q=J%26J%20Quarts&type=product">Quarts · 4 ct</a></div></div>
          <div class="brand-section"><h3>Ben &amp; Jerry's</h3><div class="brand-size-links"><a href="/search?q=Ben%20%26%20Jerrys%20Pints&type=product">Pints · 8 ct</a><a href="/search?q=B%26J%20Slice&type=product">Slices · 18 ct</a></div></div>
          <div class="brand-section"><h3>Blue Bunny</h3><div class="brand-size-links"><a href="/search?q=Blue%20Bunny%20Pints&type=product">Pints · 8 ct</a><a href="/search?q=Blue%20Bunny%20Original%20Bomb%20Pop&type=product">Bomb Pops · 24 ct</a></div></div>
          <div class="brand-section"><h3>Breyers</h3><div class="brand-size-links"><a href="/search?q=Breyers%20Pints&type=product">Pints · 8 ct</a><a href="/search?q=Breyers%20Smores&type=product">S'mores Bars · 24 ct</a></div></div>
          <div class="brand-section"><h3>Edy's</h3><div class="brand-size-links"><a href="/search?q=Edys%20Pints&type=product">Pints · 8 ct</a></div></div>
          <div class="brand-section"><h3>Häagen-Dazs</h3><div class="brand-size-links"><a href="/search?q=Haagen%20Dazs%2014oz&type=product">14 oz · 8 ct</a><a href="/search?q=Haagen%20Dazs%20Bars&type=product">Bars · 12 ct</a></div></div>
          <div class="brand-section"><h3>Nestlé</h3><div class="brand-size-links"><a href="/search?q=Nestle%207oz&type=product">7 oz · 12 ct</a><a href="/search?q=Nestle%20Sandwich&type=product">Sandwiches · 24 ct</a><a href="/search?q=Nestle%20Bar&type=product">Bars · 15–24 ct</a><a href="/search?q=Nestle%20Dibs&type=product">Dibs · 16 ct</a><a href="/search?q=Nestle%20Push%20Up&type=product">Push-Ups · 24 ct</a></div></div>
          <div class="brand-section"><h3>Good Humor</h3><div class="brand-size-links"><a href="/search?q=Good%20Humor&type=product">Bars · 24 ct</a><a href="/search?q=Good%20Humor%20Cone&type=product">Cones · 12 ct</a><a href="/search?q=Good%20Humor%20Sandwich&type=product">Sandwiches · 24 ct</a></div></div>
          <div class="brand-section"><h3>Popsicle</h3><div class="brand-size-links"><a href="/search?q=Popsicle&type=product">Pops · 12–24 ct</a><a href="/search?q=Popsicle%20Face&type=product">Character Pops · 20 ct</a><a href="/search?q=Popsicle%20Snow%20Cone&type=product">Snow Cone</a></div></div>
          <div class="brand-section"><h3>Lil Debbie</h3><div class="brand-size-links"><a href="/search?q=Lil%20Debbie&type=product">Pints · 8 ct</a></div></div>
          <div class="brand-section"><h3>Mars</h3><div class="brand-size-links"><a href="/search?q=Mars%20Pints&type=product">Pints · 8 ct</a><a href="/search?q=Mars%20Bar&type=product">Bars · 24 ct</a></div></div>
          <div class="brand-section"><h3>Magnum</h3><div class="brand-size-links"><a href="/search?q=Magnum%20Bar&type=product">Bars · 12 ct</a></div></div>
          <div class="brand-section"><h3>Helados</h3><div class="brand-size-links"><a href="/search?q=Helados%20Bar&type=product">Bars · 24 ct</a><a href="/search?q=Helados%20BOLIS&type=product">Bolis · 24 ct</a></div></div>
          <div class="brand-section"><h3>Mamitas</h3><div class="brand-size-links"><a href="/search?q=Mamitas&type=product">Creams &amp; Ices · 30 ct</a></div></div>
          <div class="brand-section"><h3>Marino</h3><div class="brand-size-links"><a href="/search?q=Marino%206oz&type=product">Italian Ice · 6 oz · 12 ct</a></div></div>
          <div class="brand-section"><h3>Rich's</h3><div class="brand-size-links"><a href="/search?q=Richs&type=product">Bars · 24 ct</a></div></div>
          <div class="brand-section"><h3>Klondike</h3><div class="brand-size-links"><a href="/search?q=Klondike&type=product">Bars &amp; Sandwiches · 24 ct</a></div></div>
          <div class="brand-section"><h3>Reese's</h3><div class="brand-size-links"><a href="/search?q=Reese%27s&type=product">Bars · 24 ct</a></div></div>
          <div class="brand-section"><h3>Starburst</h3><div class="brand-size-links"><a href="/search?q=Starburst&type=product">Bars · 12 ct</a></div></div>
          <div class="brand-section"><h3>Twix</h3><div class="brand-size-links"><a href="/search?q=Twix&type=product">Bars &amp; Pints</a></div></div>
          <div class="brand-section"><h3>Trolli</h3><div class="brand-size-links"><a href="/search?q=Trolli&type=product">Pops · 24 ct</a></div></div>
          <div class="brand-section"><h3>Nasto's</h3><div class="brand-size-links"><a href="/search?q=Nasto%27s&type=product">Spumoni · 8 ct</a><a href="/search?q=Nasto%27s%20Tartufo&type=product">Tartufo · 24 ct</a><a href="/search?q=Nasto%27s%20Tortoni&type=product">Tortoni · 12 ct</a></div></div>
          <div class="brand-section"><h3>Other Novelties</h3><div class="brand-size-links"><a href="/search?q=Garbers&type=product">Garber's · 24 ct</a><a href="/search?q=Kisko&type=product">Kisko Freeze Pops · 50 ct</a><a href="/search?q=Frollies&type=product">Frollies · 12 ct</a><a href="/search?q=Dolly%20Madison&type=product">Dolly Madison · 24 ct</a><a href="/search?q=Mrs.%20Fields&type=product">Mrs. Fields · 12 ct</a><a href="/search?q=Sweet%20Summits&type=product">Sweet Summits · 24 ct</a><a href="/search?q=Seven%20Summits&type=product">Seven Summits · 24 ct</a><a href="/search?q=Avalanche&type=product">Avalanche Cups · 12 ct</a></div></div>
        </div>
      </div>
    {% elsif collection.handle == 'beverages' %}
      <div class="catalog-navigation">
        <div class="catalog-nav-heading">
          <p class="eyebrow">Shop Beverages</p>
          <h2>Shop by Brand</h2>
          <p>Choose a brand first, then select the package size you need for your store.</p>
        </div>
        <div class="brand-sections">
          <div class="brand-section"><h3>Turkey Hill</h3><div class="brand-size-links"><a href="/search?q=TH%2018.5oz&type=product">18.5 oz · 8 ct</a><a href="/search?q=TH%20HG&type=product">Half Gallon · 8 ct</a><a href="/search?q=TH%20GAL&type=product">Gallon · 4 ct</a></div></div>
          <div class="brand-section"><h3>Simply</h3><div class="brand-size-links"><a href="/search?q=Simply%2011.5oz&type=product">11.5 oz · 12 ct</a><a href="/search?q=Simply%2059oz&type=product">59 oz · 6 ct</a></div></div>
          <div class="brand-section"><h3>Apple &amp; Eve</h3><div class="brand-size-links"><a href="/search?q=Apple%20%26%20Eve%2016oz&type=product">16 oz · 12 ct</a></div></div>
          <div class="brand-section"><h3>Nesquik</h3><div class="brand-size-links"><a href="/search?q=Nesquick%2014%20oz&type=product">14 oz · 12 ct</a></div></div>
          <div class="brand-section"><h3>V8</h3><div class="brand-size-links"><a href="/search?q=V-8&type=product">12 ct</a></div></div>
        </div>
      </div>
    {% endif %}

    {% if collection.products_count > 0 %}
      <div class="catalog-toolbar">
        <div class="catalog-count">{{ collection.products_count }} products</div>
        <form class="sort-form" method="get">
          <label for="SortBy-{{ section.id }}">Sort by</label>
          <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
            {% for option in collection.sort_options %}<option value="{{ option.value }}"{% if collection.sort_by == option.value %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
          </select>
        </form>
      </div>
      {% paginate collection.products by 24 %}
        <div class="product-grid">
          {% for product in collection.products %}
            {% assign display_title = product.title | replace: '*', '' | replace: 'PWI 2.5gal', 'Philadelphia Water Ice 2.5 Gallon' | replace: 'PWI 8 oz', 'Philadelphia Water Ice 8 oz' | replace: 'J&J 3gal', 'J&J 3 Gallon' | replace: 'J&J 3 gal', 'J&J 3 Gallon' | replace: 'TH 18.5oz', 'Turkey Hill 18.5 oz' | replace: 'TH HG', 'Turkey Hill Half Gallon' | replace: 'TH GAL', 'Turkey Hill Gallon' | replace: 'Turkey Hill 48oz', 'Turkey Hill 48 oz' | replace: '48oz', '48 oz' | replace: '18.5oz', '18.5 oz' | replace: '16oz', '16 oz' | replace: '15.2oz', '15.2 oz' | replace: '14oz', '14 oz' | replace: '11.5oz', '11.5 oz' | replace: '6oz', '6 oz' | replace: '8ct.', '8 ct.' | replace: '8ct', '8 ct' | replace: '24ct.', '24 ct.' | replace: '24ct', '24 ct' | replace: '12ct.', '12 ct.' | replace: '12ct', '12 ct' | replace: '6 pk', '6-pack' | replace: 'Nesquick', 'Nesquik' | replace: 'V-8', 'V8' | replace: 'Edys', "Edy's" | replace: 'Ben & Jerrys', "Ben & Jerry's" | replace: 'Haagen Dazs', 'Häagen-Dazs' | strip %}
            <article class="product-card">
              <a class="product-image-wrap" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ display_title | escape }}" loading="lazy">{% else %}<div class="product-image-placeholder">{{ product.vendor | default: 'Price Distribution' }}</div>{% endif %}</a>
              <div class="product-card-body">
                {% if product.vendor != blank %}<p class="product-vendor">{{ product.vendor }}</p>{% endif %}
                <h2><a href="{{ product.url }}">{{ display_title }}</a></h2>
                {% if customer.b2b? %}<div class="product-price">{{ product.price | money }}{% if product.price_varies %}<span>+</span>{% endif %}</div>{% else %}<div class="product-login-note">Log in to view wholesale pricing</div>{% endif %}
                <a class="product-link" href="{{ product.url }}">View Product <span aria-hidden="true">→</span></a>
              </div>
            </article>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Catalog pages">{% if paginate.previous %}<a class="pagination-link" href="{{ paginate.previous.url }}" aria-label="Previous page">← Previous</a>{% endif %}<span class="pagination-status">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a class="pagination-link" href="{{ paginate.next.url }}" aria-label="Next page">Next →</a>{% endif %}</nav>{% endif %}
      {% endpaginate %}
    {% else %}
      <div class="empty-catalog"><h2>Products coming soon.</h2><p>We're building the wholesale catalog now. Approved customers will be able to browse products and place orders online.</p></div>
    {% endif %}
  </div>
</section>

<style>
  .catalog-heading { max-width:820px; }
  .catalog-description { margin-top:14px; max-width:720px; color:#64748b; line-height:1.65; }
  .catalog-navigation { margin-top:34px; padding:32px; background:#f7f8fa; border-top:4px solid #12386b; }
  .catalog-nav-heading { max-width:720px; }
  .catalog-nav-heading .eyebrow { margin:0 0 8px; color:#d71920; font-size:11px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; }
  .catalog-nav-heading h2 { margin:0 0 8px; color:#12386b; font-size:30px; line-height:1.1; }
  .catalog-nav-heading p:last-child { margin:0; color:#64748b; font-size:14px; line-height:1.55; }
  .brand-sections { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:24px; }
  .brand-section { min-height:112px; padding:18px 20px; background:#fff; border:1px solid #dbe3ec; }
  .brand-section h3 { margin:0 0 12px; color:#12386b; font-size:18px; line-height:1.15; }
  .brand-size-links { display:flex; flex-wrap:wrap; gap:7px; }
  .brand-size-links a { display:inline-block; padding:8px 10px; background:#f7f8fa; border:1px solid #cbd5e1; color:#0b4ea2; font-size:12px; font-weight:800; text-decoration:none; }
  .brand-size-links a:hover { color:#fff; background:#12386b; border-color:#12386b; }
  .catalog-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20px; margin:34px 0 18px; padding:14px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); color:#64748b; font-size:13px; }
  .sort-form { display:flex; align-items:center; gap:9px; }
  .sort-form label { color:#12386b; font-size:12px; font-weight:800; }
  .sort-form select { min-width:190px; height:40px; padding:0 34px 0 11px; border:1px solid #cbd5e1; background:#fff; color:#334155; font-size:13px; }
  .product-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
  .product-card { overflow:hidden; background:#fff; border:1px solid #dbe3ec; transition:transform .18s ease,box-shadow .18s ease; }
  .product-card:hover { transform:translateY(-2px); box-shadow:0 10px 24px rgba(18,56,107,.08); }
  .product-image-wrap { display:block; aspect-ratio:1/1; background:#f7f8fa; overflow:hidden; }
  .product-image-wrap img { width:100%; height:100%; object-fit:contain; display:block; padding:16px; transition:transform .2s ease; }
  .product-card:hover .product-image-wrap img { transform:scale(1.025); }
  .product-image-placeholder { width:100%; height:100%; display:grid; place-items:center; padding:20px; text-align:center; color:#12386b; font-weight:800; }
  .product-card-body { padding:18px 18px 20px; }
  .product-vendor { margin:0 0 6px; color:#d71920; font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  .product-card h2 { margin:0; font-size:17px; line-height:1.25; }
  .product-card h2 a { color:#12386b; text-decoration:none; }
  .product-price { margin-top:12px; color:#12386b; font-size:18px; font-weight:900; }
  .product-price span { margin-left:2px; }
  .product-login-note { margin-top:12px; min-height:22px; color:#64748b; font-size:12px; line-height:1.4; }
  .product-link { display:inline-flex; gap:7px; align-items:center; margin-top:14px; color:#0b4ea2; font-size:13px; font-weight:800; text-decoration:none; }
  .product-link:hover { color:#d71920; }
  .pagination { display:flex; align-items:center; justify-content:center; gap:24px; margin-top:34px; padding-top:24px; border-top:1px solid var(--line); }
  .pagination-link { color:#0b4ea2; font-size:13px; font-weight:800; text-decoration:none; }
  .pagination-link:hover { color:#d71920; }
  .pagination-status { color:#64748b; font-size:13px; }
  .empty-catalog { margin-top:36px; padding:54px 30px; text-align:center; background:#f7f8fa; border:1px solid var(--line); }
  .empty-catalog h2 { margin:0 0 8px; color:#12386b; }
  .empty-catalog p { max-width:620px; margin:0 auto; color:#64748b; line-height:1.6; }
  @media (max-width:1050px) { .product-grid { grid-template-columns:repeat(3,1fr); } .brand-sections { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:760px) { .product-grid { grid-template-columns:repeat(2,1fr); } .catalog-toolbar { align-items:flex-start; flex-direction:column; } .sort-form { width:100%; } .sort-form select { flex:1; } }
  @media (max-width:560px) { .brand-sections { grid-template-columns:1fr; } }
  @media (max-width:480px) { .product-grid { grid-template-columns:1fr; } }
</style>

{% schema %}
{
  "name": "Collection",
  "settings": [],
  "presets": [{"name":"Collection"}]
}
{% endschema %}
