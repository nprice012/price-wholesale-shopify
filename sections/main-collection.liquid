<section class="page-shell catalog-page">
  <div class="container">
    <div class="catalog-heading">
      <p class="eyebrow">Wholesale catalog</p>
      <h1 class="page-title">{{ collection.title }}</h1>
    </div>

    {% if collection.handle == 'ice-cream' %}
      <div class="ice-cream-brand-nav">
        <div class="brand-nav-top">
          <div>
            <p class="eyebrow">Shop Ice Cream</p>
            <h2>Shop by Brand</h2>
            <p>Start with the brands your customers know, then choose the package size or format you need for your store.</p>
          </div>
          <a class="brand-directory-link" href="/pages/brands">View All Brands <span aria-hidden="true">→</span></a>
        </div>
        <div class="visual-brand-grid">
          <a class="visual-brand-card" href="/search?q=PWI&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-philadelphia-water-ice.jpg?v=1788810944" alt="Philadelphia Water Ice" loading="eager"></div><div class="visual-brand-info"><strong>Philadelphia Water Ice</strong><span>2.5 gallon tubs · 8 oz cups</span></div></a>
          <a class="visual-brand-card" href="/search?q=Turkey%20Hill&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-turkey-hill.jpg?v=1788810882" alt="Turkey Hill" loading="eager"></div><div class="visual-brand-info"><strong>Turkey Hill</strong><span>48 oz · 6 pack</span></div></a>
          <a class="visual-brand-card" href="/search?q=Sweet%20Summits&type=product"><div class="visual-brand-logo sweet-summits-logo"><img src="https://images.squarespace-cdn.com/content/v1/64ade2dec7a77c6f7b67f384/39378a39-013f-4b21-ae9a-a26879b2d488/point-of-sale-branding-graphic-design.jpg" alt="Sweet Summits" loading="lazy"></div><div class="visual-brand-info"><strong>Sweet Summits</strong><span>Sandwiches · novelties</span></div></a>
          <a class="visual-brand-card" href="/search?q=Ben%20%26%20Jerry%27s&type=product"><div class="visual-brand-logo brand-text-logo"><span>Ben &amp; Jerry's</span></div><div class="visual-brand-info"><strong>Ben &amp; Jerry's</strong><span>Pints · slices</span></div></a>
          <a class="visual-brand-card" href="/search?q=Blue%20Bunny&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-blue-bunny.jpg?v=1788810890" alt="Blue Bunny" loading="lazy"></div><div class="visual-brand-info"><strong>Blue Bunny</strong><span>Pints · Bomb Pops</span></div></a>
          <a class="visual-brand-card" href="/search?q=Breyers&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-breyers.jpg?v=1788810903" alt="Breyers" loading="lazy"></div><div class="visual-brand-info"><strong>Breyers</strong><span>Pints · S'mores Bars</span></div></a>
          <a class="visual-brand-card" href="/search?q=Good%20Humor&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-good-humor.jpg?v=1788810897" alt="Good Humor" loading="lazy"></div><div class="visual-brand-info"><strong>Good Humor</strong><span>Bars · cones · sandwiches</span></div></a>
          <a class="visual-brand-card" href="/search?q=Popsicle&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-popsicle.jpg?v=1788810914" alt="Popsicle" loading="lazy"></div><div class="visual-brand-info"><strong>Popsicle</strong><span>Pops · character pops</span></div></a>
          <a class="visual-brand-card" href="/search?q=Nestle&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-nestle.webp?v=1788810920" alt="Nestlé" loading="lazy"></div><div class="visual-brand-info"><strong>Nestlé</strong><span>Sandwiches · bars · Dibs</span></div></a>
          <a class="visual-brand-card" href="/search?q=Mars&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-mars-ice-cream.webp?v=1788810932" alt="Mars" loading="lazy"></div><div class="visual-brand-info"><strong>Mars</strong><span>Pints · bars</span></div></a>
          <a class="visual-brand-card" href="/search?q=Magnum&type=product"><div class="visual-brand-logo"><img src="https://cdn.shopify.com/s/files/1/0857/5621/5552/files/brand-magnum.jpg?v=1788810938" alt="Magnum" loading="lazy"></div><div class="visual-brand-info"><strong>Magnum</strong><span>Premium bars</span></div></a>
        </div>
        <div class="brand-format-strip"><span>Also available:</span><a href="/search?q=Edy%27s&type=product">Edy's</a><a href="/search?q=Haagen%20Dazs&type=product">Häagen-Dazs</a><a href="/search?q=Helados&type=product">Helados</a><a href="/search?q=Mamitas&type=product">Mamitas</a><a href="/search?q=Marino&type=product">Marino</a><a href="/search?q=Richs&type=product">Rich's</a><a href="/search?q=Klondike&type=product">Klondike</a><a href="/search?q=Reese%27s&type=product">Reese's</a><a href="/search?q=Starburst&type=product">Starburst</a><a href="/search?q=Twix&type=product">Twix</a><a href="/search?q=Trolli&type=product">Trolli</a></div>
      </div>
    {% elsif collection.handle == 'beverages' %}
      <div class="beverage-brand-nav">
        <div class="brand-nav-top">
          <div><p class="eyebrow">Shop Beverages</p><h2>Brands for your beverage set</h2><p>Stock recognizable beverage brands in the package formats your customers are looking for.</p></div>
          <a class="brand-directory-link" href="/pages/brands">View All Brands <span aria-hidden="true">→</span></a>
        </div>
        <div class="beverage-brand-grid">
          <a class="beverage-brand-card" href="/search?q=Turkey%20Hill&type=product"><div class="beverage-brand-image"><img src="{{ 'brand-turkey-hill.svg' | asset_url }}" alt="Turkey Hill" loading="eager"></div><div class="beverage-brand-copy"><div><span class="brand-card-kicker">Turkey Hill</span><h3>Turkey Hill</h3></div><span class="brand-card-arrow">→</span><p>18.5 oz · half gallon · gallon</p></div></a>
          <a class="beverage-brand-card" href="/search?q=Simply&type=product"><div class="beverage-brand-image"><img src="{{ 'brand-simply.svg' | asset_url }}" alt="Simply" loading="lazy"></div><div class="beverage-brand-copy"><div><span class="brand-card-kicker">Juice &amp; lemonade</span><h3>Simply</h3></div><span class="brand-card-arrow">→</span><p>11.5 oz · 59 oz</p></div></a>
          <a class="beverage-brand-card" href="/search?q=Apple%20%26%20Eve&type=product"><div class="beverage-brand-image"><img src="{{ 'brand-apple-eve.svg' | asset_url }}" alt="Apple &amp; Eve" loading="lazy"></div><div class="beverage-brand-copy"><div><span class="brand-card-kicker">Juice</span><h3>Apple &amp; Eve</h3></div><span class="brand-card-arrow">→</span><p>16 oz · 12 count</p></div></a>
          <a class="beverage-brand-card" href="/search?q=Nesquick&type=product"><div class="beverage-brand-image"><img src="{{ 'brand-nesquik.svg' | asset_url }}" alt="Nesquik" loading="lazy"></div><div class="beverage-brand-copy"><div><span class="brand-card-kicker">Flavored milk</span><h3>Nesquik</h3></div><span class="brand-card-arrow">→</span><p>14 oz · 12 count</p></div></a>
          <a class="beverage-brand-card" href="/search?q=V-8&type=product"><div class="beverage-brand-image"><img src="{{ 'brand-v8.svg' | asset_url }}" alt="V8" loading="lazy"></div><div class="beverage-brand-copy"><div><span class="brand-card-kicker">Vegetable &amp; fruit drinks</span><h3>V8</h3></div><span class="brand-card-arrow">→</span><p>12 count</p></div></a>
        </div>
      </div>
    {% endif %}

    {% if collection.products_count > 0 %}
      <div class="catalog-toolbar"><div class="catalog-count">{{ collection.products_count }} products</div><form class="sort-form" method="get"><label for="SortBy-{{ section.id }}">Sort by</label><select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if collection.sort_by == option.value %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>
      {% paginate collection.products by 24 %}
        <div class="product-grid">
          {% for product in collection.products %}
            {% assign display_title = product.title | replace: '*', '' | replace: 'PWI 2.5gal', 'Philadelphia Water Ice 2.5 Gallon' | replace: 'PWI 8 oz', 'Philadelphia Water Ice 8 oz' | replace: 'J&J 3gal', 'J&J 3 Gallon' | replace: 'J&J 3 gal', 'J&J 3 Gallon' | replace: 'TH 18.5oz', 'Turkey Hill 18.5 oz' | replace: 'TH HG', 'Turkey Hill Half Gallon' | replace: 'TH GAL', 'Turkey Hill Gallon' | replace: 'Turkey Hill 48oz', 'Turkey Hill 48 oz' | replace: '48oz', '48 oz' | replace: '18.5oz', '18.5 oz' | replace: '16oz', '16 oz' | replace: '15.2oz', '15.2 oz' | replace: '14oz', '14 oz' | replace: '11.5oz', '11.5 oz' | replace: '6oz', '6 oz' | replace: '8ct.', '8 ct.' | replace: '8ct', '8 ct' | replace: '24ct.', '24 ct.' | replace: '24ct', '24 ct' | replace: '12ct.', '12 ct.' | replace: '12ct', '12 ct' | replace: '6 pk', '6-pack' | replace: 'Nesquick', 'Nesquik' | replace: 'V-8', 'V8' | replace: 'Edys', "Edy's" | replace: 'Ben & Jerrys', "Ben & Jerry's" | replace: 'Haagen Dazs', 'Häagen-Dazs' | strip %}
            <article class="product-card"><a class="product-image-wrap" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ display_title | escape }}" loading="lazy">{% else %}<div class="product-image-placeholder">{{ product.vendor | default: 'Price Distribution' }}</div>{% endif %}</a><div class="product-card-body">{% if product.vendor != blank %}<p class="product-vendor">{{ product.vendor }}</p>{% endif %}<h2><a href="{{ product.url }}">{{ display_title }}</a></h2>{% if customer.b2b? %}<div class="product-price">{{ product.price | money }}{% if product.price_varies %}<span>+</span>{% endif %}</div>{% else %}<div class="product-login-note">Log in to view wholesale pricing</div>{% endif %}<a class="product-link" href="{{ product.url }}">View Product <span aria-hidden="true">→</span></a></div></article>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Catalog pages">{% if paginate.previous %}<a class="pagination-link" href="{{ paginate.previous.url }}" aria-label="Previous page">← Previous</a>{% endif %}<span class="pagination-status">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a class="pagination-link" href="{{ paginate.next.url }}" aria-label="Next page">Next →</a>{% endif %}</nav>{% endif %}
      {% endpaginate %}
    {% else %}<div class="empty-catalog"><h2>Products coming soon.</h2><p>We're building the wholesale catalog now. Approved customers will be able to browse products and place orders online.</p></div>{% endif %}
  </div>
</section>

<style>
  .catalog-heading{max-width:820px}
  .ice-cream-brand-nav,.beverage-brand-nav{margin-top:28px;padding:28px;background:#f7f9fb;border:1px solid #d8e1ea;border-top:4px solid #12386b;border-radius:2px}
  .brand-nav-top{display:flex;align-items:flex-end;justify-content:space-between;gap:30px}.brand-nav-top h2{margin:0 0 8px;color:#12386b;font-size:32px;line-height:1.1}.brand-nav-top p:last-child{margin:0;max-width:680px;color:#64748b;font-size:14px;line-height:1.5}.brand-directory-link{color:#12386b;font-size:11px;font-weight:900;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;white-space:nowrap}.brand-directory-link:hover{color:#d71920}
  .visual-brand-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:22px}.visual-brand-card{overflow:hidden;background:#fff;border:1px solid #d5dee8;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.visual-brand-card:hover{transform:translateY(-2px);border-color:#aebfd1;box-shadow:0 8px 20px rgba(18,56,107,.09)}
  .visual-brand-logo{height:142px;padding:14px 18px;display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden}.visual-brand-logo img{display:block;width:auto!important;height:auto!important;max-width:78%!important;max-height:112px!important;object-fit:contain}.sweet-summits-logo img{max-width:82%!important;max-height:118px!important}.brand-text-logo{background:#f5f7f9;color:#12386b;font-size:23px;font-weight:900;letter-spacing:-.03em;text-align:center}.visual-brand-info{min-height:64px;padding:11px 13px 12px;border-top:1px solid #edf0f3}.visual-brand-info strong{display:block;color:#12386b;font-size:14px;line-height:1.2}.visual-brand-info span{display:block;margin-top:4px;color:#7a8795;font-size:10px;line-height:1.3}
  .brand-format-strip{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin-top:16px;padding-top:16px;border-top:1px solid #dce3ea}.brand-format-strip>span{margin-right:4px;color:#718096;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.brand-format-strip a{padding:6px 9px;background:#fff;border:1px solid #d2dce6;color:#12386b;font-size:10px;font-weight:800;text-decoration:none}.brand-format-strip a:hover{color:#fff;background:#12386b;border-color:#12386b}
  .beverage-brand-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:22px}.beverage-brand-card{overflow:hidden;background:#fff;border:1px solid #d7e0e9;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease}.beverage-brand-card:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(18,56,107,.09)}.beverage-brand-image{height:150px;padding:16px;display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden}.beverage-brand-image img{width:auto!important;height:auto!important;max-width:82%!important;max-height:110px!important;object-fit:contain}.beverage-brand-copy{position:relative;padding:13px 14px 15px;border-top:1px solid #edf0f3}.beverage-brand-copy h3{margin:2px 0 0;color:#12386b;font-size:18px;line-height:1.1}.brand-card-kicker{color:#d71920;font-size:8px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.beverage-brand-copy p{margin:8px 0 0;color:#6b7a8d;font-size:10px;line-height:1.35}.brand-card-arrow{position:absolute;right:14px;top:15px;color:#0b4ea2;font-size:15px;font-weight:900}
  .catalog-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:30px 0 18px;padding:13px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:#64748b;font-size:13px}.sort-form{display:flex;align-items:center;gap:9px}.sort-form label{color:#12386b;font-size:12px;font-weight:800}.sort-form select{min-width:190px;height:40px;padding:0 34px 0 11px;border:1px solid #cbd5e1;background:#fff;color:#334155;font-size:13px}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product-card{overflow:hidden;background:#fff;border:1px solid #dbe3ec}.product-image-wrap{display:block;aspect-ratio:1/1;background:#f7f8fa;overflow:hidden}.product-image-wrap img{width:100%;height:100%;object-fit:contain;display:block;padding:16px}.product-image-placeholder{width:100%;height:100%;display:grid;place-items:center;padding:20px;text-align:center;color:#12386b;font-weight:800}.product-card-body{padding:18px}.product-vendor{margin:0 0 6px;color:#d71920;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.product-card h2{margin:0;font-size:17px;line-height:1.25}.product-card h2 a{color:#12386b;text-decoration:none}.product-price{margin-top:12px;color:#12386b;font-size:18px;font-weight:900}.product-login-note{margin-top:12px;min-height:22px;color:#64748b;font-size:12px}.product-link{display:inline-flex;gap:7px;align-items:center;margin-top:14px;color:#0b4ea2;font-size:13px;font-weight:800;text-decoration:none}.pagination{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:34px;padding-top:24px;border-top:1px solid var(--line)}.pagination-link{color:#0b4ea2;font-size:13px;font-weight:800;text-decoration:none}.pagination-status{color:#64748b;font-size:13px}.empty-catalog{margin-top:36px;padding:54px 30px;text-align:center;background:#f7f8fa;border:1px solid var(--line)}.empty-catalog h2{color:#12386b}
  @media(max-width:1100px){.beverage-brand-grid{grid-template-columns:repeat(3,1fr)}.visual-brand-grid{grid-template-columns:repeat(3,1fr)}.product-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:760px){.brand-nav-top{align-items:flex-start;flex-direction:column}.beverage-brand-grid,.visual-brand-grid{grid-template-columns:repeat(2,1fr)}.ice-cream-brand-nav,.beverage-brand-nav{padding:22px}.product-grid{grid-template-columns:repeat(2,1fr)}.catalog-toolbar{align-items:flex-start;flex-direction:column}.sort-form{width:100%}.sort-form select{flex:1}}
  @media(max-width:480px){.beverage-brand-grid,.visual-brand-grid,.product-grid{grid-template-columns:1fr}.beverage-brand-image{height:190px}.visual-brand-logo{height:150px}}
</style>

{% schema %}
{"name":"Collection","settings":[],"presets":[{"name":"Collection"}]}
{% endschema %}