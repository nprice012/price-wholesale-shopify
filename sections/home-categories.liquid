<section class="section partner-section">
  <div class="container">
    <div class="partner-intro">
      <p class="eyebrow">Food &amp; Beverage Distribution</p>
      <h2>A Partner You Can Count On</h2>
      <p>Price Distribution has been delivering the products people love since 1921. We proudly supply ice cream, beverages and more to convenience stores, grocery stores and retailers throughout Baltimore, Washington and the surrounding areas.</p>
    </div>

    <div class="partner-benefits">
      <div class="partner-benefit"><div class="partner-benefit-icon" aria-hidden="true">✦</div><div><h3>Wide Selection</h3><p>The brands and products your customers ask for.</p></div></div>
      <div class="partner-benefit"><div class="partner-benefit-icon" aria-hidden="true">▣</div><div><h3>On-Time Delivery</h3><p>Reliable service that keeps your shelves stocked.</p></div></div>
      <div class="partner-benefit"><div class="partner-benefit-icon" aria-hidden="true">⌖</div><div><h3>Local Expertise</h3><p>Serving Baltimore, Washington and surrounding markets.</p></div></div>
      <div class="partner-benefit"><div class="partner-benefit-icon" aria-hidden="true">♧</div><div><h3>Lasting Partnerships</h3><p>Personal service built around your business.</p></div></div>
    </div>
  </div>
</section>

<style>
  .partner-section { background:#fff; padding-top:58px; padding-bottom:64px; }
  .partner-intro { max-width:760px; margin:0 auto; text-align:center; }
  .partner-intro .eyebrow { margin:0 0 12px; color:#6b7280; font-size:12px; font-weight:800; letter-spacing:.28em; text-transform:uppercase; }
  .partner-intro h2 { margin:0 0 14px; color:#12386b; font-size:clamp(34px,4vw,48px); line-height:1.05; font-weight:900; text-transform:uppercase; letter-spacing:-.025em; }
  .partner-intro > p:last-child { margin:0 auto; color:#4b5563; font-size:16px; line-height:1.7; max-width:720px; }
  .partner-benefits { display:grid; grid-template-columns:repeat(4,1fr); margin-top:48px; border-top:1px solid #dbe3ec; border-bottom:1px solid #dbe3ec; }
  .partner-benefit { min-height:112px; display:flex; align-items:center; gap:16px; padding:22px 28px; border-right:1px solid #dbe3ec; }
  .partner-benefit:last-child { border-right:0; }
  .partner-benefit-icon { width:46px; flex:0 0 46px; height:46px; display:grid; place-items:center; border:2px solid #0b4ea2; border-radius:50%; color:#0b4ea2; font-size:21px; font-weight:900; }
  .partner-benefit h3 { margin:0 0 3px; color:#12386b; font-size:18px; line-height:1.1; }
  .partner-benefit p { margin:0; color:#64748b; font-size:13px; line-height:1.35; }
  @media (max-width:980px) { .partner-benefits { grid-template-columns:repeat(2,1fr); } .partner-benefit:nth-child(2) { border-right:0; } .partner-benefit:nth-child(-n+2) { border-bottom:1px solid #dbe3ec; } }
  @media (max-width:640px) { .partner-section { padding-top:48px; } .partner-benefits { grid-template-columns:1fr; } .partner-benefit { border-right:0; border-bottom:1px solid #dbe3ec; } .partner-benefit:last-child { border-bottom:0; } }
</style>

