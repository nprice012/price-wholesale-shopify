<section class="section history-section">
  <div class="container">
    <div class="history-heading">
      <p class="eyebrow">Our history</p>
      <h2>Built on more than a century of service.</h2>
      <p>Since 1921, Price Distribution has built its business on dependable service, strong customer relationships and the brands people know and trust.</p>
    </div>

    <div class="history-points">
      <div class="history-point">
        <span class="history-number">1921</span>
        <h3>A family business from the start.</h3>
        <p>More than 100 years of experience serving businesses throughout our region.</p>
      </div>
      <div class="history-point">
        <span class="history-number">01</span>
        <h3>Personal service.</h3>
        <p>We know our customers and understand what it takes to keep their shelves stocked.</p>
      </div>
      <div class="history-point">
        <span class="history-number">02</span>
        <h3>Built for your business.</h3>
        <p>A dependable wholesale partner focused on selection, delivery and long-term relationships.</p>
      </div>
    </div>

    <div class="history-action">
      <a class="btn btn-outline" href="/pages/about-us">Learn More About Us</a>
    </div>
  </div>
</section>

<style>
  .history-section { background:#f7f8fa; padding:72px 0 76px; }
  .history-heading { max-width:780px; margin-bottom:42px; }
  .history-heading .eyebrow { margin:0 0 10px; color:#d71920; font-size:12px; font-weight:800; letter-spacing:.24em; text-transform:uppercase; }
  .history-heading h2 { margin:0 0 14px; color:#12386b; font-size:clamp(32px,4vw,48px); line-height:1.05; font-weight:900; letter-spacing:-.025em; }
  .history-heading > p:last-child { margin:0; max-width:700px; color:#4b5563; font-size:16px; line-height:1.7; }
  .history-points { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid #dbe3ec; border-bottom:1px solid #dbe3ec; }
  .history-point { padding:30px 34px 32px; border-right:1px solid #dbe3ec; }
  .history-point:last-child { border-right:0; }
  .history-number { display:block; margin-bottom:16px; color:#d71920; font-size:32px; line-height:1; font-weight:900; letter-spacing:-.03em; }
  .history-point h3 { margin:0 0 8px; color:#12386b; font-size:19px; line-height:1.2; }
  .history-point p { margin:0; color:#64748b; font-size:14px; line-height:1.55; }
  .history-action { margin-top:30px; }
  @media (max-width:760px) { .history-points { grid-template-columns:1fr; } .history-point { border-right:0; border-bottom:1px solid #dbe3ec; } .history-point:last-child { border-bottom:0; } }
</style>

{% schema %}
{
  "name": "Company history",
  "settings": [],
  "presets": [{"name": "Company history"}]
}
{% endschema %}
