<section class="page-shell">
  <div class="container">
    {% if section.settings.show_title %}<h1 class="page-title">{{ page.title }}</h1>{% endif %}
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "settings": [
    {"type":"checkbox","id":"show_title","label":"Show page title","default":true}
  ]
}
{% endschema %}
