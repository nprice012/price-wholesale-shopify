<section class="page-shell">
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h1 class="page-title">Let's talk wholesale.</h1>
    <p class="page-lead">Questions about products, service, opening an account or placing an order? Send us a message and our team will get back to you.</p>
    <div class="apply-grid">
      <div>
        {% form 'contact', id: 'PriceWholesaleContactForm' %}
          {% if form.posted_successfully? %}<div class="form-success">Thanks. We received your message.</div>{% endif %}
          {{ form.errors | default_errors }}
          <div class="form-grid">
            <label>Name<input type="text" name="contact[name]" required></label>
            <label>Email<input type="email" name="contact[email]" required></label>
          </div>
          <label>Phone<input type="tel" name="contact[phone]"></label>
          <label>Message<textarea name="contact[body]" rows="7" required></textarea></label>
          <button class="btn btn-primary" type="submit">Send Message</button>
        {% endform %}
      </div>
      <aside class="apply-aside">
        <strong>Price Wholesale Distribution</strong>
        <p>Family owned since 1921.<br>Serving the Baltimore &amp; Washington market.</p>
        <p><strong>Phone</strong><br><a href="tel:4436045677">443-604-5677</a></p>
        <p><strong>Email</strong><br><a href="mailto:Nprice.icd@gmail.com">Nprice.icd@gmail.com</a></p>
        <div class="aside-divider"></div>
        <strong>Looking to open an account?</strong>
        <p>Start with our wholesale account request and tell us about your business.</p>
        <a class="btn btn-outline" href="/pages/become-a-customer">Become a Customer</a>
      </aside>
    </div>
  </div>
</section>

<style>
  .aside-divider { height:1px; background:#dbe3ec; margin:28px 0; }
  .apply-aside a:not(.btn) { color:var(--navy); font-weight:700; text-decoration:none; }
  .apply-aside a:not(.btn):hover { text-decoration:underline; }
</style>

{% schema %}
{
  "name": "Contact",
  "settings": [],
  "presets": [{"name":"Contact"}]
}
{% endschema %}
