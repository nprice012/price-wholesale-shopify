<section class="page-shell">
  <div class="container">
    <h1 class="page-title">Your Order</h1>
    {% if cart.item_count == 0 %}
      <p>Your order is empty.</p>
      <a class="btn btn-primary" href="{{ routes.collections_url }}">Browse Wholesale Products</a>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post">
        {% for item in cart.items %}
          <div style="display:grid;grid-template-columns:1fr auto;gap:20px;padding:20px 0;border-bottom:1px solid var(--line);">
            <div><strong>{{ item.product.title }}</strong><div>{{ item.variant.title }}</div><div>{{ item.final_line_price | money }}</div></div>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:90px;padding:10px;border:1px solid var(--line);height:44px;">
          </div>
        {% endfor %}
        <div style="display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:28px;">
          <button class="btn btn-outline" type="submit">Update Order</button>
          <div style="text-align:right"><strong style="font-size:24px;">{{ cart.total_price | money }}</strong><br><button class="btn btn-primary" type="submit" name="checkout">Proceed to Checkout</button></div>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{"name":"Cart","settings":[]}
{% endschema %}
